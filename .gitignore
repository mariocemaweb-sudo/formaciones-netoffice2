## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Pp]ublish/

# SQLite Database
*.db
*.db-shm
*.db-wal

# Uploaded files (opcional - puedes comentar estas líneas si quieres hacer commit de los archivos subidos)
wwwroot/uploads/videos/*
!wwwroot/uploads/videos/.gitkeep
wwwroot/uploads/archivos/*
!wwwroot/uploads/archivos/.gitkeep

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# Logs
*.log
logs/

# Others
*.cache
*.dll
*.exe
*.pdb
