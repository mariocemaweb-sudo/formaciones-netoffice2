@model Formacion
@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-action="Index" class="btn" style="background-color: #0A7BB8; color: white;">
                <i class="fas fa-arrow-left"></i> Volver a Formaciones
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Panel izquierdo: Videos -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%); color: white;">
                    <h4 class="mb-0">@Model.Titulo</h4>
                </div>
                <div class="card-body">
                    <p class="lead">@Model.Descripcion</p>
                    @if (!string.IsNullOrEmpty(Model.Categoria))
                    {
                        <p><span class="badge" style="background-color: #0A7BB8;">@Model.Categoria</span></p>
                    }
                </div>
            </div>

            <!-- Reproductor de Video -->
            @if (Model.Videos.Any())
            {
                <div class="card mb-3">
                    <div class="card-header" style="background-color: #0A7BB8; color: white;">
                        <h5 class="mb-0"><i class="fas fa-video"></i> Videos de la Formación</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var video in Model.Videos)
                        {
                            <div class="mb-4 border-bottom pb-3">
                                <h6>@video.Titulo</h6>
                                @if (!string.IsNullOrEmpty(video.Descripcion))
                                {
                                    <p class="text-muted">@video.Descripcion</p>
                                }
                                
                                <!-- Reproductor de video HTML5 -->
                                <video controls class="w-100 mb-2" style="max-height: 500px; background: #000;">
                                    <source src="@video.RutaArchivo" type="video/mp4">
                                    Tu navegador no soporta la reproducción de videos.
                                </video>
                                
                                <small class="text-muted">
                                    <i class="fas fa-calendar"></i> Subido el @video.FechaSubida.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No hay videos disponibles para esta formación.
                </div>
            }
        </div>

        <!-- Panel derecho: Archivos -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header" style="background-color: #1A5490; color: white;">
                    <h5 class="mb-0"><i class="fas fa-file-alt"></i> Material Complementario</h5>
                </div>
                <div class="card-body">
                    @if (Model.Archivos.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var archivo in Model.Archivos)
                            {
                                <div class="list-group-item px-0">
                                    <h6 class="mb-1">
                                        @if (archivo.TipoArchivo == ".pdf")
                                        {
                                            <i class="fas fa-file-pdf text-danger"></i>
                                        }
                                        else if (archivo.TipoArchivo == ".doc" || archivo.TipoArchivo == ".docx")
                                        {
                                            <i class="fas fa-file-word text-primary"></i>
                                        }
                                        else if (archivo.TipoArchivo == ".xls" || archivo.TipoArchivo == ".xlsx")
                                        {
                                            <i class="fas fa-file-excel text-success"></i>
                                        }
                                        else if (archivo.TipoArchivo == ".ppt" || archivo.TipoArchivo == ".pptx")
                                        {
                                            <i class="fas fa-file-powerpoint text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-file"></i>
                                        }
                                        @archivo.Titulo
                                    </h6>
                                    
                                    @if (!string.IsNullOrEmpty(archivo.Descripcion))
                                    {
                                        <p class="mb-2 text-muted small">@archivo.Descripcion</p>
                                    }
                                    
                                    <small class="text-muted d-block mb-2">
                                        @archivo.NombreArchivo (@(archivo.TamanoBytes / 1024 / 1024) MB)
                                    </small>
                                    
                                    <a asp-action="DescargarArchivo" asp-route-id="@archivo.Id" 
                                       class="btn btn-sm" style="background-color: #002B4C; color: white;">
                                        <i class="fas fa-download"></i> Descargar
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle"></i> No hay archivos complementarios.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
