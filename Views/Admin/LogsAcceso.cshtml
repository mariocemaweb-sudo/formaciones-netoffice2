@model IEnumerable<AccesoLog>
@{
    ViewData["Title"] = "Logs de Acceso";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <h2><i class="fas fa-history"></i> Registro de Accesos</h2>
            <p class="text-muted">Últimos 100 intentos de inicio de sesión</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Fecha/Hora</th>
                                        <th>Email</th>
                                        <th>Estado</th>
                                        <th>IP</th>
                                        <th>Navegador</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model)
                                    {
                                        <tr class="@(log.ExitosoAcceso ? "" : "table-danger")">
                                            <td>@log.FechaAcceso.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td><strong>@log.Email</strong></td>
                                            <td>
                                                @if (log.ExitosoAcceso)
                                                {
                                                    <span class="badge" style="background-color: #0A7BB8;">
                                                        <i class="fas fa-check"></i> Exitoso
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background-color: #E74C3C;">
                                                        <i class="fas fa-times"></i> Fallido
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <code>@(log.DireccionIP ?? "N/A")</code>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @if (!string.IsNullOrEmpty(log.Navegador))
                                                    {
                                                        @(log.Navegador.Length > 80 ? log.Navegador.Substring(0, 80) + "..." : log.Navegador)
                                                    }
                                                    else
                                                    {
                                                        <span>N/A</span>
                                                    }
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No hay registros de acceso todavía.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
