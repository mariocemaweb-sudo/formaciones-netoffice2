@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Estadísticas por Empresa";
    var estadisticasPorEmpresa = Model
        .Where(u => !string.IsNullOrEmpty(u.Empresa))
        .GroupBy(u => u.Empresa)
        .Select(g => new {
            Empresa = g.Key,
            TotalUsuarios = g.Count(),
            UsuariosActivos = g.Count(u => u.Activo),
            UsuariosInactivos = g.Count(u => !u.Activo),
            Administradores = g.Count(u => u.Rol == "Admin"),
            UltimoAcceso = g.Max(u => u.UltimoAcceso)
        })
        .OrderByDescending(e => e.TotalUsuarios);
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="fas fa-chart-bar"></i> Estadísticas por Empresa</h2>
                <a asp-action="Usuarios" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver a Usuarios
                </a>
            </div>
        </div>
    </div>

    <!-- Resumen general -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card" style="background-color: #F5F5F5;">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h3 style="color: #002B4C;">@estadisticasPorEmpresa.Count()</h3>
                            <p class="mb-0">Empresas Registradas</p>
                        </div>
                        <div class="col-md-3">
                            <h3 style="color: #0A7BB8;">@Model.Count()</h3>
                            <p class="mb-0">Total Usuarios</p>
                        </div>
                        <div class="col-md-3">
                            <h3 style="color: #17A2B8;">@Model.Count(u => u.Activo)</h3>
                            <p class="mb-0">Usuarios Activos</p>
                        </div>
                        <div class="col-md-3">
                            <h3 style="color: #FF9D00;">@Model.Count(u => u.Rol == "Admin")</h3>
                            <p class="mb-0">Administradores</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de estadísticas por empresa -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%); color: white;">
                    <h5 class="mb-0">Detalle por Empresa</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-building"></i> Empresa</th>
                                    <th class="text-center"><i class="fas fa-users"></i> Total Usuarios</th>
                                    <th class="text-center"><i class="fas fa-check-circle text-success"></i> Activos</th>
                                    <th class="text-center"><i class="fas fa-times-circle text-danger"></i> Inactivos</th>
                                    <th class="text-center"><i class="fas fa-user-shield"></i> Admins</th>
                                    <th class="text-center"><i class="fas fa-clock"></i> Último Acceso</th>
                                    <th class="text-center">% del Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in estadisticasPorEmpresa)
                                {
                                    var porcentaje = (stat.TotalUsuarios * 100.0 / Model.Count()).ToString("F1");
                                    <tr>
                                        <td><strong>@stat.Empresa</strong></td>
                                        <td class="text-center">
                                            <span class="badge" style="background-color: #002B4C;">@stat.TotalUsuarios</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge" style="background-color: #0A7BB8;">@stat.UsuariosActivos</span>
                                        </td>
                                        <td class="text-center">
                                            @if (stat.UsuariosInactivos > 0)
                                            {
                                                <span class="badge" style="background-color: #E74C3C;">@stat.UsuariosInactivos</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (stat.Administradores > 0)
                                            {
                                                <span class="badge" style="background-color: #FF9D00; color: white;">@stat.Administradores</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (stat.UltimoAcceso.HasValue)
                                            {
                                                @stat.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin accesos</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="progress" style="height: 25px;">
                                                <div class="progress-bar" role="progressbar" 
                                                     style="width: @porcentaje%; background-color: #002B4C;" 
                                                     aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                                                    @porcentaje%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfico visual (opcional - usando barras HTML/CSS) -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%); color: white;">
                    <h5 class="mb-0">Distribución de Usuarios por Empresa</h5>
                </div>
                <div class="card-body">
                    @foreach (var stat in estadisticasPorEmpresa.Take(10))
                    {
                        var porcentaje = (stat.TotalUsuarios * 100.0 / Model.Count());
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <strong>@stat.Empresa</strong>
                                <span>@stat.TotalUsuarios usuarios</span>
                            </div>
                            <div class="progress" style="height: 30px;">
                                <div class="progress-bar" role="progressbar" 
                                     style="width: @porcentaje%; background-color: #1A5490;" 
                                     aria-valuenow="@porcentaje" aria-valuemin="0" aria-valuemax="100">
                                    @porcentaje.ToString("F1")%
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
