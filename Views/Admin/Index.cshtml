@model IEnumerable<Formacion>
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2><i class="fas fa-dashboard"></i> Panel de Administración</h2>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%);">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Formaciones</h6>
                            <h2>@ViewBag.TotalFormaciones</h2>
                        </div>
                        <div>
                            <i class="fas fa-book fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white" style="background-color: #0A7BB8;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Videos</h6>
                            <h2>@ViewBag.TotalVideos</h2>
                        </div>
                        <div>
                            <i class="fas fa-video fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white" style="background-color: #17A2B8;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Archivos</h6>
                            <h2>@ViewBag.TotalArchivos</h2>
                        </div>
                        <div>
                            <i class="fas fa-file fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white" style="background-color: #FF9D00;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Usuarios</h6>
                            <h2>@ViewBag.TotalUsuarios</h2>
                        </div>
                        <div>
                            <i class="fas fa-users fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white" style="background-color: #4A5568;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title">Empresas</h6>
                            <h2>@ViewBag.TotalEmpresas</h2>
                        </div>
                        <div>
                            <i class="fas fa-building fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de formaciones -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Formaciones</h5>
                    <a asp-action="CrearFormacion" class="btn btn-light btn-sm">
                        <i class="fas fa-plus"></i> Nueva Formación
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Categoría</th>
                                        <th>Videos</th>
                                        <th>Archivos</th>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var formacion in Model)
                                    {
                                        <tr>
                                            <td><strong>@formacion.Titulo</strong></td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(formacion.Categoria))
                                                {
                                                    <span class="badge bg-secondary">@formacion.Categoria</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-success">
                                                    <i class="fas fa-video"></i> @formacion.Videos.Count
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    <i class="fas fa-file"></i> @formacion.Archivos.Count
                                                </span>
                                            </td>
                                            <td>@formacion.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (formacion.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactivo</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="EditarFormacion" asp-route-id="@formacion.Id" 
                                                       class="btn btn-primary" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-danger" 
                                                            onclick="confirmarEliminar(@formacion.Id, '@formacion.Titulo')" 
                                                            title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay formaciones creadas todavía.
                            <a asp-action="CrearFormacion">Crear la primera formación</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para confirmar eliminación -->
<form id="formEliminar" asp-action="EliminarFormacion" method="post" style="display:none;">
    <input type="hidden" id="idEliminar" name="id" />
</form>

@section Scripts {
<script>
    function confirmarEliminar(id, titulo) {
        if (confirm('¿Está seguro de eliminar la formación "' + titulo + '"?\n\nSe eliminarán todos los videos y archivos asociados.')) {
            document.getElementById('idEliminar').value = id;
            document.getElementById('formEliminar').submit();
        }
    }
</script>
}
