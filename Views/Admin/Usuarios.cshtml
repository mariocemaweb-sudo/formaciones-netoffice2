@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    var usuariosAgrupados = Model.GroupBy(u => u.Empresa).OrderBy(g => g.Key);
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2><i class="fas fa-users"></i> Gestión de Usuarios</h2>
                    <p class="text-muted">Total: @Model.Count() usuarios en @usuariosAgrupados.Count() empresa(s)</p>
                </div>
                <a asp-action="CrearUsuario" class="btn" style="background-color: #002B4C; color: white;">
                    <i class="fas fa-user-plus"></i> Nuevo Usuario
                </a>
            </div>
        </div>
    </div>

    <!-- Filtro por empresa -->
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <label class="form-label mb-0">
                                <i class="fas fa-filter"></i> Filtrar por empresa:
                            </label>
                        </div>
                        <div class="col-md-6">
                            <select id="filtroEmpresa" class="form-select">
                                <option value="">Todas las empresas</option>
                                @foreach (var grupo in usuariosAgrupados)
                                {
                                    <option value="@grupo.Key">@grupo.Key (@grupo.Count())</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button onclick="limpiarFiltro()" class="btn w-100" style="background-color: #0A7BB8; color: white;">
                                <i class="fas fa-times"></i> Limpiar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Usuarios agrupados por empresa -->
    @foreach (var grupoEmpresa in usuariosAgrupados)
    {
        <div class="row mb-4 empresa-grupo" data-empresa="@grupoEmpresa.Key">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%); color: white;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-building"></i> @grupoEmpresa.Key
                            </h5>
                            <span class="badge" style="background-color: #F5F5F5; color: #002B4C;">@grupoEmpresa.Count() usuario(s)</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Email</th>
                                        <th>Nombre</th>
                                        <th>Rol</th>
                                        <th>Fecha Creación</th>
                                        <th>Último Acceso</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in grupoEmpresa.OrderBy(u => u.Nombre))
                                    {
                                        <tr>
                                            <td>@usuario.Email</td>
                                            <td><strong>@usuario.Nombre</strong></td>
                                            <td>
                                                @if (usuario.Rol == "Admin")
                                                {
                                                    <span class="badge" style="background-color: #E74C3C;">Admin</span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background-color: #002B4C;">Usuario</span>
                                                }
                                            </td>
                                            <td>@usuario.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (usuario.UltimoAcceso.HasValue)
                                                {
                                                    @usuario.UltimoAcceso.Value.ToString("dd/MM/yyyy HH:mm")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Nunca</span>
                                                }
                                            </td>
                                            <td>
                                                @if (usuario.Activo)
                                                {
                                                    <span class="badge" style="background-color: #0A7BB8;">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background-color: #6C757D;">Inactivo</span>
                                                }
                                            </td>
                                            <td>
                                                @if (usuario.Email != "admin@formaciones.com")
                                                {
                                                    <form asp-action="EliminarUsuario" method="post" 
                                                          onsubmit="return confirm('¿Eliminar usuario @usuario.Nombre?');"
                                                          style="display:inline;">
                                                        <input type="hidden" name="id" value="@usuario.Id" />
                                                        <button type="submit" class="btn btn-sm" style="background-color: #E74C3C; color: white;">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Admin principal</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="alert alert-info">
                    No hay usuarios registrados.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    document.getElementById('filtroEmpresa').addEventListener('change', function() {
        const empresaSeleccionada = this.value;
        const grupos = document.querySelectorAll('.empresa-grupo');
        
        grupos.forEach(grupo => {
            if (empresaSeleccionada === '' || grupo.dataset.empresa === empresaSeleccionada) {
                grupo.style.display = '';
            } else {
                grupo.style.display = 'none';
            }
        });
    });

    function limpiarFiltro() {
        document.getElementById('filtroEmpresa').value = '';
        document.querySelectorAll('.empresa-grupo').forEach(grupo => {
            grupo.style.display = '';
        });
    }
</script>
}

