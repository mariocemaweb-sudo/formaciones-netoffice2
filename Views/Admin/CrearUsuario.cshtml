@model Usuario
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header" style="background: linear-gradient(135deg, #002B4C 0%, #1A5490 100%); color: white;">
                    <h4 class="mb-0"><i class="fas fa-user-plus"></i> Nuevo Usuario</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CrearUsuario" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Empresa" class="form-label">Empresa</label>
                            <input asp-for="Empresa" class="form-control" list="empresasList" placeholder="Escribe o selecciona una empresa" />
                            <datalist id="empresasList">
                                @if (ViewBag.Empresas != null)
                                {
                                    @foreach (var empresa in ViewBag.Empresas)
                                    {
                                        <option value="@empresa"></option>
                                    }
                                }
                            </datalist>
                            <span asp-validation-for="Empresa" class="text-danger"></span>
                            <small class="text-muted">Puedes escribir una nueva empresa o seleccionar una existente</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label">Nombre</label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="text-muted">Mínimo 6 caracteres</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rol" class="form-label">Rol</label>
                            <select asp-for="Rol" class="form-select">
                                <option value="Usuario">Usuario</option>
                                <option value="Admin">Administrador</option>
                            </select>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Activo" type="checkbox" class="form-check-input" checked />
                            <label asp-for="Activo" class="form-check-label">
                                Usuario activo
                            </label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Usuarios" class="btn" style="background-color: #0A7BB8; color: white;">
                                <i class="fas fa-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn" style="background-color: #002B4C; color: white;">
                                <i class="fas fa-save"></i> Crear Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
